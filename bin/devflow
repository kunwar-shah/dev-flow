#!/usr/bin/env bash

#######################################
# DevFlow - Laragon-style Development Environment for WSL/Linux
# Main CLI entry point
#
# Usage:
#   devflow <command> <subcommand> [options] [arguments]
#
# Version: 0.1.0-dev
# License: MIT
#######################################

set -euo pipefail

# Version
DEVFLOW_VERSION="0.1.0-dev"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Determine installation directory
if [ -n "${DEVFLOW_LIB_DIR:-}" ]; then
    LIB_DIR="$DEVFLOW_LIB_DIR"
elif [ -d "$(dirname "$0")/../lib" ]; then
    # Development mode - relative to bin/devflow
    LIB_DIR="$(cd "$(dirname "$0")/../lib" && pwd)"
elif [ -d "/opt/devflow/lib" ]; then
    # System installation
    LIB_DIR="/opt/devflow/lib"
else
    echo "Error: Cannot find DevFlow library directory" >&2
    exit 1
fi

# Export for child scripts
export DEVFLOW_LIB_DIR="$LIB_DIR"
export DEVFLOW_VERSION

# Load core libraries
# shellcheck source=lib/core/utils.sh
source "$LIB_DIR/core/utils.sh"
# shellcheck source=lib/core/logger.sh
source "$LIB_DIR/core/logger.sh"
# shellcheck source=lib/core/config.sh
source "$LIB_DIR/core/config.sh"
# shellcheck source=lib/core/validator.sh
source "$LIB_DIR/core/validator.sh"

#######################################
# Display version information
# Globals:
#   DEVFLOW_VERSION
# Outputs:
#   Version string to stdout
#######################################
show_version() {
    echo "DevFlow version $DEVFLOW_VERSION"
}

#######################################
# Display help information
# Outputs:
#   Help text to stdout
#######################################
show_help() {
    cat << 'EOF'
╔══════════════════════════════════════════════════════════════╗
║        DevFlow - Development Environment for WSL/Linux       ║
║              Laragon-style LAMP Stack Manager                ║
╚══════════════════════════════════════════════════════════════╝

Usage:
  devflow <command> <subcommand> [options] [arguments]

CORE COMMANDS:
  site        Manage development sites
    create      Create new site with Apache vhost
    list        List all sites
    delete      Delete site and files
    info        Show site details
    open        Open site in browser

  php         Manage PHP versions (7.4, 8.0, 8.1, 8.2, 8.3)
    install     Install PHP version with extensions
    list        Show installed/available versions
    uninstall   Remove PHP version
    switch      Change default PHP version
    info        Show PHP version details

  db          Manage MySQL/MariaDB databases
    create      Create database with optional user
    list        List all databases
    delete      Delete database
    import      Import SQL file
    export      Export database to SQL file

  ssl         Manage SSL certificates
    install-ca  Create self-signed Root CA
    create      Generate SSL certificate for site
    list        List all certificates
    delete      Remove certificate
    trust       Install Root CA in system

UTILITY COMMANDS:
  service     Manage system services
    status      Show service status
    start       Start service(s)
    stop        Stop service(s)
    restart     Restart service(s)
    logs        View service logs

  logs        View and monitor logs
    site        View site logs (access/error)
    tail        Follow logs in real-time
    clear       Clear site logs
    list        List all log files

  backup      Backup and restore
    site        Backup site files
    db          Backup database
    all         Backup site + database
    restore     Restore from backup
    list        List all backups

  hosts       Manage hosts file
    add         Add entry to hosts file
    remove      Remove entry from hosts file
    sync        Sync all sites to hosts
    list        List DevFlow entries

  migrate     Migrate projects from Windows to WSL
    <source>    Migrate project to WSL filesystem
    scan        Scan for projects to migrate

SYSTEM COMMANDS:
  doctor      Run system health checks
  update      Update DevFlow to latest version

Global Options:
  --help, -h       Show this help message
  --version, -v    Show version information
  --verbose        Enable verbose output
  --quiet          Suppress non-error output
  --debug          Enable debug mode with set -x

Quick Start:
  # 1. Create a site
  devflow site create myapp.test php8.2

  # 2. Add to hosts file
  devflow hosts add myapp.test

  # 3. Create SSL certificate (optional)
  devflow ssl install-ca
  devflow ssl create myapp.test

  # 4. Create database (optional)
  devflow db create myapp_db

  # 5. Open in browser
  devflow site open myapp.test

Examples:
  devflow site create api.test php8.3 public
  devflow php install 8.3
  devflow db import myapp_db backup.sql
  devflow backup all myapp.test
  devflow service status
  devflow doctor

Get Help:
  devflow <command> --help      Show command-specific help
  devflow site --help            Show site command help
  devflow doctor                 Check system health

Repository: https://github.com/kunwar-shah/dev-flow
Issues:     https://github.com/kunwar-shah/dev-flow/issues

EOF
}

#######################################
# Parse global options
# Arguments:
#   All command-line arguments
# Returns:
#   0 on success, 1 on error
#######################################
parse_global_options() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --help|-h)
                show_help
                exit 0
                ;;
            --version|-v)
                show_version
                exit 0
                ;;
            --verbose)
                export DEVFLOW_VERBOSE=1
                shift
                ;;
            --quiet)
                export DEVFLOW_QUIET=1
                shift
                ;;
            --debug)
                export DEVFLOW_DEBUG=1
                set -x
                shift
                ;;
            --)
                shift
                break
                ;;
            -*)
                log_error "Unknown option: $1"
                echo "Run 'devflow --help' for usage information."
                return 1
                ;;
            *)
                # Not a global option, break to process command
                break
                ;;
        esac
    done

    # Store remaining arguments
    DEVFLOW_ARGS=("$@")
}

#######################################
# Route command to appropriate handler
# Arguments:
#   Command name and arguments
# Returns:
#   Command exit code
#######################################
route_command() {
    local command="${1:-}"

    if [ -z "$command" ]; then
        show_help
        return 0
    fi

    shift || true

    case "$command" in
        site)
            # shellcheck source=lib/commands/site.sh
            source "$LIB_DIR/commands/site.sh"
            site_command "$@"
            ;;
        php)
            # shellcheck source=lib/commands/php.sh
            source "$LIB_DIR/commands/php.sh"
            php_command "$@"
            ;;
        ssl)
            # shellcheck source=lib/commands/ssl.sh
            source "$LIB_DIR/commands/ssl.sh"
            ssl_command "$@"
            ;;
        db)
            # shellcheck source=lib/commands/db.sh"
            source "$LIB_DIR/commands/db.sh"
            db_command "$@"
            ;;
        service)
            # shellcheck source=lib/commands/service.sh
            source "$LIB_DIR/commands/service.sh"
            service_command "$@"
            ;;
        migrate)
            # shellcheck source=lib/commands/migrate.sh
            source "$LIB_DIR/commands/migrate.sh"
            migrate_command "$@"
            ;;
        logs)
            # shellcheck source=lib/commands/logs.sh
            source "$LIB_DIR/commands/logs.sh"
            logs_command "$@"
            ;;
        backup)
            # shellcheck source=lib/commands/backup.sh
            source "$LIB_DIR/commands/backup.sh"
            backup_command "$@"
            ;;
        hosts)
            # shellcheck source=lib/commands/hosts.sh
            source "$LIB_DIR/commands/hosts.sh"
            hosts_command "$@"
            ;;
        doctor)
            # shellcheck source=lib/commands/doctor.sh
            source "$LIB_DIR/commands/doctor.sh"
            doctor_command "$@"
            ;;
        update)
            # shellcheck source=lib/commands/update.sh
            source "$LIB_DIR/commands/update.sh"
            update_command "$@"
            ;;
        help)
            show_help
            return 0
            ;;
        *)
            log_error "Unknown command: $command"
            echo ""
            echo "Run 'devflow --help' for available commands."
            return 1
            ;;
    esac
}

#######################################
# Main entry point
# Arguments:
#   All command-line arguments
# Returns:
#   Exit code from routed command
#######################################
main() {
    # Parse global options
    parse_global_options "$@"

    # Remaining arguments after global options
    set -- "${DEVFLOW_ARGS[@]}"

    # Initialize (load config if available)
    config_init || {
        log_warn "Could not load configuration, using defaults"
    }

    # Route to command handler
    route_command "$@"
}

# Run main if executed directly (not sourced)
if [ "${BASH_SOURCE[0]}" = "${0}" ]; then
    main "$@"
fi
